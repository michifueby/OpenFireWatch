# =============================================================================
# OpenFireWatch — environment configuration
#
# Quick start:
#   cp .env.example .env        # then adjust the values below
#   docker compose up --build
#
# Every service reads its configuration exclusively from the environment
# (12-factor). Inside Docker Compose, the in-network hostnames (db, redis)
# are injected by docker-compose.yml and override the localhost values here,
# so the same file works for both containerized and on-host development.
#
# NEVER commit the real `.env` — it is gitignored.
# =============================================================================

# --- PostgreSQL / PostGIS ----------------------------------------------------
# Single source of truth: spatial filtering (ST_Intersects) + deduplication.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openfirewatch
POSTGRES_USER=openfirewatch
# REQUIRED — compose refuses to start without it (no insecure default).
POSTGRES_PASSWORD=change-me-in-production

# --- Redis (event bus: BullMQ queues + pub/sub) --------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- NASA FIRMS / LANCE (satellite thermal anomalies) ---------------------------
# REQUIRED. Free map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your-nasa-firms-map-key
# Satellite source: VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT
# OPTIONAL override of the polled bounding box: west,south,east,north (WGS84).
#
# LEAVE THIS EMPTY (the default). The area is then derived automatically from
# the active high_risk_zones on every cycle — add a zone and the polled box
# grows to cover it, with no configuration change and no restart.
#
# Why this is the default: a hotspot must be inside the box to be ingested AND
# inside a zone to raise an alert. When both were configured by hand, a box
# that failed to cover its zones disabled them *silently* — the pipeline looked
# healthy while being unable to ever fire. Deriving one from the other makes
# that state impossible.
#
# Set it only to deliberately watch a WIDER area than your zones (e.g. to
# collect context detections around the hazard sites). Note the single-weather-
# station caveat below before enlarging.
FIRMS_AREA=

# Padding added around the zone extent when deriving the box, in degrees.
FIRMS_AREA_PADDING_DEG=0.05

# Polling interval in seconds (FIRMS NRT updates roughly every 5–10 minutes).
#
# NASA rate limit: 5000 transactions per 10 minutes per map key. One cycle =
# one FIRMS request, so the default 300 s uses 2 of 5000 (0.04 %) — even the
# 60 s floor only reaches 10. The limit is effectively irrelevant here; polling
# faster than the satellites publish (~5–10 min) just wastes calls without
# producing new data. Note the key is shared across ALL deployments that use
# it, so a key reused by many stacks is the only realistic way to hit it.
#
# Check your live quota:
#   curl "https://firms.modaps.eosdis.nasa.gov/mapserver/mapkey_status/?MAP_KEY=$FIRMS_MAP_KEY"
FIRMS_POLL_INTERVAL=300

# --- Weather -----------------------------------------------------------------------
# Air temperature (TL) and relative humidity (RF) come from GeoSphere Austria's
# TAWES station network (free, no key). Topsoil moisture comes from Open-Meteo
# (free, no key). Both endpoints are configured in workers/src/clients/.
#
# IMPORTANT: one station reading is correlated with EVERY hotspot in FIRMS_AREA.
# That is accurate for a compact monitoring area like the Föhrenwald (~15 km),
# but meaningless if you widen FIRMS_AREA to a whole country or continent — the
# ignition rule would then judge distant fires by local Austrian weather. If you
# monitor a large or scattered region, fetch weather per detection coordinate
# instead (see fetchStationWeather / fetchTopsoilMoisturePct).
GEOSPHERE_STATION_ID=11090

# For end-to-end drills without waiting for a real satellite pass, use the
# backend endpoint instead:  curl -X POST http://localhost:8000/api/simulate-fire

# --- Operator access -----------------------------------------------------------------
# REQUIRED for every WRITE endpoint (zone editor, simulate-fire). Reads stay
# public. Without it, writes are refused — the guard fails closed rather than
# leaving hazard-zone management open to anyone who can reach the port.
# Generate one with:  openssl rand -hex 24
OPERATOR_API_KEY=change-me-generate-with-openssl-rand-hex-24

# --- Backend API (NestJS) --------------------------------------------------------
# Host port for REST + Swagger (/api/docs) + Socket.IO.
API_PORT=8000
# Comma-separated origins allowed for CORS + WebSocket handshakes.
# Only needed when the frontend is NOT served through the bundled nginx
# (which proxies same-origin and needs no CORS at all).
CORS_ORIGINS=http://localhost:4200

# --- Frontend (Angular + nginx) ----------------------------------------------------
# Host port for the live map.
FRONTEND_PORT=4200

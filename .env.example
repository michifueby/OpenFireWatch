# =============================================================================
# OpenFireWatch — environment configuration
#
# Quick start:
#   cp .env.example .env        # then adjust the values below
#   docker compose up --build
#
# Every service reads its configuration exclusively from the environment
# (12-factor). Inside Docker Compose, the in-network hostnames (db, redis)
# are injected by docker-compose.yml and override the localhost values here,
# so the same file works for both containerized and on-host development.
#
# NEVER commit the real `.env` — it is gitignored.
# =============================================================================

# --- PostgreSQL / PostGIS ----------------------------------------------------
# Single source of truth: spatial filtering (ST_Intersects) + deduplication.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=openfirewatch
POSTGRES_USER=openfirewatch
# REQUIRED — compose refuses to start without it (no insecure default).
POSTGRES_PASSWORD=change-me-in-production

# --- Redis (event bus: BullMQ queues + pub/sub) --------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379

# --- NASA FIRMS / LANCE (satellite thermal anomalies) ---------------------------
# REQUIRED. Free map key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=your-nasa-firms-map-key
# Satellite source: VIIRS_SNPP_NRT | VIIRS_NOAA20_NRT | MODIS_NRT
FIRMS_SOURCE=VIIRS_SNPP_NRT
# OPTIONAL override of the polled bounding box: west,south,east,north (WGS84).
#
# LEAVE THIS EMPTY (the default). The area is then derived automatically from
# the active high_risk_zones on every cycle — add a zone and the polled box
# grows to cover it, with no configuration change and no restart.
#
# Why this is the default: a hotspot must be inside the box to be ingested AND
# inside a zone to raise an alert. When both were configured by hand, a box
# that failed to cover its zones disabled them *silently* — the pipeline looked
# healthy while being unable to ever fire. Deriving one from the other makes
# that state impossible.
#
# Set it only to deliberately watch a WIDER area than your zones (e.g. to
# collect context detections around the hazard sites). Note the single-weather-
# station caveat below before enlarging.
FIRMS_AREA=

# Padding added around the zone extent when deriving the box, in degrees.
FIRMS_AREA_PADDING_DEG=0.05

# Polling interval in seconds (FIRMS NRT updates roughly every 5–10 minutes).
#
# NASA rate limit: 5000 transactions per 10 minutes per map key. One cycle =
# one FIRMS request, so the default 300 s uses 2 of 5000 (0.04 %) — even the
# 60 s floor only reaches 10. The limit is effectively irrelevant here; polling
# faster than the satellites publish (~5–10 min) just wastes calls without
# producing new data. Note the key is shared across ALL deployments that use
# it, so a key reused by many stacks is the only realistic way to hit it.
#
# Check your live quota:
#   curl "https://firms.modaps.eosdis.nasa.gov/mapserver/mapkey_status/?MAP_KEY=$FIRMS_MAP_KEY"
FIRMS_POLL_INTERVAL=300

# --- Weather -----------------------------------------------------------------------
# Air temperature (TL) and relative humidity (RF) come from GeoSphere Austria's
# TAWES station network (free, no key). Topsoil moisture comes from Open-Meteo
# (free, no key). Both endpoints are configured in workers/src/clients/.
#
# IMPORTANT: one station reading is correlated with EVERY hotspot in FIRMS_AREA.
# That is accurate for a compact monitoring area like the Föhrenwald (~15 km),
# but meaningless if you widen FIRMS_AREA to a whole country or continent — the
# ignition rule would then judge distant fires by local Austrian weather. If you
# monitor a large or scattered region, fetch weather per detection coordinate
# instead (see fetchStationWeather / fetchTopsoilMoisturePct).
GEOSPHERE_STATION_ID=11090

# For end-to-end drills without waiting for a real satellite pass, use the
# backend endpoint instead:  curl -X POST http://localhost:8000/api/simulate-fire

# --- Operator access -----------------------------------------------------------------
# REQUIRED for every WRITE endpoint (zone editor, simulate-fire). Reads stay
# public. Without it, writes are refused — the guard fails closed rather than
# leaving hazard-zone management open to anyone who can reach the port.
# Generate one with:  openssl rand -hex 24
OPERATOR_API_KEY=change-me-generate-with-openssl-rand-hex-24

# --- Ground sensors (optional) ------------------------------------------------
# Shared secret a LoRaWAN network server presents when POSTing readings to
# /api/sensors/readings (header X-Sensor-Token, or as a Bearer token). A
# separate credential from OPERATOR_API_KEY on purpose: the gateway holds this
# one and can do nothing else with it. Unset = sensor intake refused.
SENSOR_INGEST_TOKEN=

# How old a sensor reading may be and still stand in for current ground
# conditions. Battery-powered LoRaWAN nodes report every 15-60 min; the
# default tolerates a missed uplink or two. Past this, evaluation falls back
# to the regional estimate — a dead sensor must never report calm conditions.
SENSOR_MAX_AGE_MINUTES=90

# --- Backend API (NestJS) --------------------------------------------------------
# Host port for REST + Swagger (/api/docs) + Socket.IO.
API_PORT=8000
# Comma-separated origins allowed for CORS + WebSocket handshakes.
# Only needed when the frontend is NOT served through the bundled nginx
# (which proxies same-origin and needs no CORS at all).
CORS_ORIGINS=http://localhost:4200

# --- Frontend (Angular + nginx) ----------------------------------------------------
# Host port for the live map.
FRONTEND_PORT=4200

# --- Public deployment (only needed with docker-compose.prod.yml) -------------------
# The domain that resolves to this server; Caddy obtains a certificate for it.
DOMAIN=
# Contact address Let's Encrypt uses for expiry notices.
ACME_EMAIL=
#
# On a public server, bind the API and the web UI to LOOPBACK so only Caddy is
# reachable from outside — Docker publishes ports by writing iptables rules that
# BYPASS ufw, so a firewall rule alone would not close them:
#   API_PORT=127.0.0.1:8000
#   FRONTEND_PORT=127.0.0.1:4200
#
# And set CORS_ORIGINS to the public URL. Otherwise the Socket.IO handshake
# still answers 200 but omits the access-control-allow-origin header, so the
# browser discards it and the map never receives live alerts — while the server
# logs look perfectly healthy:
#   CORS_ORIGINS=https://your.domain

# =============================================================================
# Benachrichtigungen
#
# Jeder Kanal wird ausschließlich durch seine eigenen Variablen aktiviert. Ist
# nichts gesetzt, bleiben alle stumm und Alarme erscheinen nur auf der Karte —
# ein Ausgangszustand, der niemanden ungefragt anruft.
#
# Prüfen lässt sich die Einrichtung ohne echtes Ereignis:
#   curl -X POST http://localhost:8000/api/notifications/test -H "x-api-key: $OPERATOR_API_KEY"
# =============================================================================

# --- Webhook: der allgemeine Weg ---------------------------------------------
# Ein POST mit JSON an eine beliebige URL. Damit erreicht das System alles,
# wofür es keinen eigenen Kanal gibt: eigene Alarmierung, Slack, Mattermost,
# ein E-Mail-Relay, ein Skript.
NOTIFY_WEBHOOK_URL=
# Optional, aber empfohlen: signiert jede Meldung mit HMAC-SHA256 im Kopffeld
# X-OpenFireWatch-Signature, damit der Empfänger echte Meldungen von jemandem
# unterscheiden kann, der die URL erraten hat.
NOTIFY_WEBHOOK_SECRET=

# --- Telegram: Nachricht in einen Gruppenchat --------------------------------
# Kostenlos, in Sekunden am Telefon, für die ganze Mannschaft in einer Gruppe.
# Einrichtung: bei @BotFather einen Bot anlegen, den Bot in die Gruppe holen,
# dort einmal schreiben und die Chat-ID auslesen unter
#   https://api.telegram.org/bot<TOKEN>/getUpdates
NOTIFY_TELEGRAM_BOT_TOKEN=
NOTIFY_TELEGRAM_CHAT_ID=

# --- Zündfenster-Vorhersage ---------------------------------------------------
# Wie oft die 7-Tage-Vorhersage je Zone erneuert wird (Sekunden).
FORECAST_POLL_INTERVAL=3600
# Wie weit im Voraus ein Zündfenster eine Benachrichtigung wert ist (Stunden).
# Drei Tage: planbar, und die Vorhersage ist auf dieser Distanz belastbar.
FORECAST_WARN_HOURS=72

# --- Saisonale Auswertung -----------------------------------------------------
# Wie viele Jahre Wetterhistorie je Zone nachgeladen werden.
HISTORY_YEARS=10
# Wie oft nach Lücken gesucht wird (Sekunden). Ein abgeschlossenes Jahr wird
# genau einmal geholt, der Lauf findet also fast immer nichts zu tun.
HISTORY_BACKFILL_INTERVAL=86400

# --- Eskalation ---------------------------------------------------------------
# Bleibt ein kritischer Alarm so viele Minuten unquittiert, wird einmalig über
# alle Kanäle erinnert. 0 schaltet die Eskalation ab.
NOTIFY_ESCALATE_MINUTES=15

# --- Was gemeldet wird --------------------------------------------------------
# critical: nur kritische Alarme und ein Ausfall der Datenaufnahme.
# warning:  zusätzlich die Entwarnung, wenn die Aufnahme wieder läuft.
# info:     alles.
NOTIFY_MIN_SEVERITY=warning

# Adresse, die in jeder Meldung verlinkt wird.
PUBLIC_URL=https://openfirewatch.org

# --- Sensor-eigene Alarme -----------------------------------------------------
# Eine Bodensonde kann selbst Alarm auslösen — der Fall, den kein Satellit
# sieht: Glut unter der Oberfläche oder unter geschlossenem Kronendach.
# Absoluter Grenzwert (kalibriert, °C). 0 schaltet diesen Auslöser ab.
SENSOR_ALERT_TEMPERATURE_C=50
# Anstiegs-Auslöser: mindestens so viele Kelvin über dem Median der letzten
# sechs Stunden, und mindestens 35 °C absolut (damit ein kalter Morgen, der
# zu einem heißen Mittag wird, nie alarmiert). 0 schaltet ihn ab.
SENSOR_ALERT_RISE_C=15
# Ein Alarm je Sonde und Episode; so lange gilt dieselbe Hitze als bekannt.
SENSOR_ALERT_COOLDOWN_HOURS=6

# --- Sprache der Benachrichtigungen -------------------------------------------
# de oder en. Gilt je Installation, nicht je Empfänger: eine Meldung geht an
# einen Kanal, und eine Mannschaft teilt sich den Kanal.
NOTIFY_LANGUAGE=de

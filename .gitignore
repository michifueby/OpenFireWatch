# Environment — never commit secrets
.env

# Dependencies
node_modules/

# Build/tool caches (npm cache dirs appear when installing inside containers
# with the project mounted; .angular is the Angular CLI build cache)
npm-cache/
.angular/
*.tsbuildinfo

# Build output
dist/
out-tsc/

# LaTeX build artefacts (the .tex and the generated .pdf are versioned)
*.aux
*.fdb_latexmk
*.fls
*.out
*.toc
*.synctex.gz

# Logs & OS noise
*.log
.DS_Store

# IDE
.idea/
.vscode/
